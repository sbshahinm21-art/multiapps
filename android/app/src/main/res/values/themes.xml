<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MultiApps" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Invisible screens used by the work-profile engine. -->
    <style name="Theme.MultiApps.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <color name="bg">#FF0B0D12</color>
    <color name="ic_bg">#FF6C8CFF</color>
</resources>
